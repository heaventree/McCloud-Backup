generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Site {
  id                Int        @id @default(autoincrement())
  name              String
  url               String
  apiKey            String     @map("api_key")
  status            String     @default("active")
  lastBackup        DateTime?  @map("last_backup")
  backupFrequency   String     @map("backup_frequency") @default("ondemand")
  backupMode        String     @map("backupMode") @default("ALL")
  storageProviderId Int?       @map("storage_provider_id")
  pluginVerified    Boolean    @map("plugin_verified") @default(false)
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  backups           Backup[]
  feedbacks         Feedback[]

  @@map("sites")
}

model Backup {
  id                Int       @id @default(autoincrement())
  siteId            Int       @map("site_id")
  storageProviderId Int?      @map("storage_provider_id")
  filename          String?
  filesize          Int?
  beforeSize        Int?      @map("before_size")
  afterSize         Int?      @map("after_size")
  failedSize        Int?      @map("failed_size")
  backupType        String    @map("backup_type") @default("full")
  status            String    @default("pending")
  storageType       String?   @map("storage_type")
  storagePath       String?   @map("storage_path")
  processId         String?   @map("process_id")
  metadata          String?   @db.Text
  error             String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  site              Site      @relation(fields: [siteId], references: [id])

  @@map("backups")
}

model Feedback {
  id         Int       @id @default(autoincrement())
  siteId     Int       @map("site_id")
  type       String
  content    String
  pageUrl    String    @map("page_url")
  status     String    @default("new")
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")
  site       Site      @relation(fields: [siteId], references: [id])

  @@map("feedbacks")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String?
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model NotificationPreferences {
  id                        Int      @id @default(autoincrement())
  emailEnabled              Boolean  @map("email_enabled") @default(false)
  emailAddress              String?  @map("email_address")
  emailBackupCompleted      Boolean  @map("email_backup_completed") @default(true)
  emailBackupFailed         Boolean  @map("email_backup_failed") @default(true)
  emailStorageWarning       Boolean  @map("email_storage_warning") @default(true)
  smsEnabled                Boolean  @map("sms_enabled") @default(false)
  smsPhoneNumber            String?  @map("sms_phone_number")
  smsBackupFailed           Boolean  @map("sms_backup_failed") @default(true)
  smsCriticalStorageWarning Boolean  @map("sms_critical_storage_warning") @default(true)
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

model StorageProvider {
  id        Int      @id @default(autoincrement())
  type      String
  name      String
  config    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("storage_providers")
}

model Notification {
  id                Int      @id @default(autoincrement())
  title             String
  message           String
  type              String
  category          String   @default("system")
  siteId            Int?     @map("site_id")
  storageProviderId Int?     @map("storage_provider_id")
  read              Boolean  @default(false)
  data              String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("notifications")
}
